{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": { "enabled": false },
	"files": {
		"includes": ["**", "!**/node_modules", "!**/.review-atlas", "!**/.claude", "!**/dist"]
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["src/ui/components/ui/**", "src/ui/hooks/use-mobile.ts"],
			"linter": { "enabled": false }
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
