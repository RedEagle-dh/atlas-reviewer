{
	"name": "review-atlas",
	"version": "0.1.0",
	"description": "Makes the changes of a git branch reviewable in the browser: what changed, how it hangs together, and the code.",
	"private": true,
	"type": "module",
	"scripts": {
		"atlas": "bun bin/review-atlas.ts serve",
		"atlas:check": "bun bin/review-atlas.ts check",
		"test": "bun test src reviews",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dagrejs/dagre": "^3.1.3",
		"@xyflow/react": "^13.0.2",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.76.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shadcn": "^4.23.0",
		"shiki": "^4.6.0",
		"sonner": "^2.0.8",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/bun": "^1.4.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0"
	}
}
